VITE_BASE_HOST=http://localhost
# Host del auth-service. Déjalo vacío para usar VITE_BASE_HOST.
VITE_AUTH_HOST=http://localhost:3000
# Path del auth-service. En producción suele ser /auth; localmente (servicio directo) dejarlo vacío.
VITE_AUTH_PATH=
# Host del database-service. Déjalo vacío para usar VITE_BASE_HOST.
VITE_DATABASE_HOST=http://localhost:3002
# Path del database-service. En producción suele ser /database; localmente dejarlo vacío.
VITE_DATABASE_PATH=
VITE_PROJECT_ID=contrato_id
VITE_REALTIME_HOST=http://localhost:3003
VITE_ID_CONSULTA_LISTA_USUARIOS=#colocar aquí el ID de la consulta que traiga la lista de usuarios del sistema
